{#
/**
 * @file
 * The page for buying one product.
 *
 * Available variables:
 * - product: the product's name.
 * - button: opens Paddle's checkout; shown by its script.
 * - downloads_url: where customers with a key go.
 */
#}
<div class="license-checkout">
  <p>{{ 'A licence for @product with one year of updates: every version released during that year.'|t({'@product': product}) }}</p>
  <ul>
    <li>{{ 'You pay once. The licence key arrives by e-mail right after the payment.'|t }}</li>
    <li>{{ 'The versions released during the year remain yours and keep working after it. For later versions, buy a new licence; we remind you before the year ends.'|t }}</li>
    <li>{{ 'The next step shows the price with the taxes of your country. The payment is handled by Paddle, our reseller.'|t }}</li>
  </ul>
  {{ button }}
  <noscript><p>{{ 'Buying needs JavaScript.'|t }}</p></noscript>
  <p>{{ 'Already have a key? <a href=":url">Go to your downloads</a>.'|t({':url': downloads_url}) }}</p>
</div>
